# --- QueryPilot configuration ---------------------------------------------
# Copy to .env and fill in. Never commit a real .env with secrets.

# Google AI Studio API key (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# Postgres connection string (matches db/docker-compose.yml defaults)
DATABASE_URL=postgresql://querypilot:querypilot@localhost:5433/querypilot

# Optional overrides
GEMINI_MODEL=gemini-2.0-flash
ROW_LIMIT=200
STATEMENT_TIMEOUT_MS=10000
